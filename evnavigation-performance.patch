+func TestPlanRoute_AsksFinderForConnectorAndEnoughRows(t *testing.T) {
+	cfg := testConfig()
+	cfg.SearchRadiusMeters = 70000
+	svc, _, f := newTestService(t, cfg, stn(1, 100), stn(2, 120), stn(3, 140))
