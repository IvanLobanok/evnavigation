+	for i, got := range f.gotConnectors {
+		if len(got) != 1 || got[0] != testEV.ConnectorType {
+			t.Errorf("call %d: connectors %v, want [%s]: фильтр по разъёму должен уйти в базу", i, got, testEV.ConnectorType)
+		}
