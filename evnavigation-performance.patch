diff --git a/internal/handler/ratelimit.go b/internal/handler/ratelimit.go
new file mode 100644
index 0000000..411e89b
--- /dev/null
+++ b/internal/handler/ratelimit.go
@@ -0,0 +1,178 @@
+package handler
+
+import (
+	"math"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// RateLimit - ограничение частоты запросов на один ключ (IP или пользователя) по схеме «токенового ведра»:
+// в ведре помещается Burst запросов, а пополняется оно со скоростью PerMinute запросов в минуту.
+// PerMinute <= 0 выключает ограничение.
+type RateLimit struct {
+	PerMinute int
+	Burst     int
+}
+
+// RateLimits собирает ограничения для групп эндпоинтов. Нулевое значение выключает все ограничения.
+type RateLimits struct {
+	Auth   RateLimit // по IP: POST /auth/register и /auth/login (внутри каждого запроса - bcrypt)
+	Public RateLimit // по IP: GET /ev-models и /stations/nearby (без авторизации)
+	Routes RateLimit // по пользователю: POST /routes (самый дорогой запрос: вызовы провайдера и поиск станций)
+
+	// TrustProxyHeaders: брать IP клиента из последнего значения X-Forwarded-For.
+	// Включайте, только если сервис стоит за собственным прокси, который этот заголовок дописывает:
+	// иначе клиент подставит любой IP и обойдёт лимит. Без прокси держите выключенным.
+	// Если сервис за прокси, а флаг выключен, все клиенты делят один IP прокси и один общий лимит.
+	TrustProxyHeaders bool
+}
+
+const (
+	// maxLimiterKeys ограничивает память: больше ключей не отслеживаем (см. allow).
+	maxLimiterKeys = 100_000
+	sweepInterval  = time.Minute
+)
+
+type bucket struct {
+	tokens float64
+	last   time.Time
+}
+
+// limiter - набор вёдер по ключам. Горутин не запускает: простаивающие ключи вычищаются при обращениях.
+type limiter struct {
+	mu        sync.Mutex
+	buckets   map[string]*bucket
+	rate      float64 // токенов в секунду
+	burst     float64
+	now       func() time.Time
+	lastSweep time.Time
+}
+
+// newLimiter возвращает nil, если ограничение выключено.
+func newLimiter(rl RateLimit) *limiter {
+	if rl.PerMinute <= 0 {
+		return nil
+	}
+	burst := rl.Burst
+	if burst < 1 {
+		burst = 1
+	}
+	return &limiter{
+		buckets: make(map[string]*bucket),
+		rate:    float64(rl.PerMinute) / 60,
+		burst:   float64(burst),
+		now:     time.Now,
+	}
+}
+
+// allow расходует один токен ключа. Если токенов нет, возвращает false и время до следующего токена.
+func (l *limiter) allow(key string) (bool, time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	now := l.now()
+	l.sweep(now)
+
+	b, ok := l.buckets[key]
+	if !ok {
+		if len(l.buckets) >= maxLimiterKeys {
+			// Памяти больше не даём: лучше пропустить запрос без учёта, чем отказать всем новым клиентам.
+			return true, 0
+		}
+		b = &bucket{tokens: l.burst, last: now}
+		l.buckets[key] = b
+	}
+
+	if elapsed := now.Sub(b.last).Seconds(); elapsed > 0 {
+		b.tokens = math.Min(l.burst, b.tokens+elapsed*l.rate)
+		b.last = now
+	}
+	if b.tokens >= 1 {
+		b.tokens--
+		return true, 0
+	}
+	return false, time.Duration((1 - b.tokens) / l.rate * float64(time.Second))
+}
+
+// sweep удаляет вёдра, которые успели наполниться доверху: они равнозначны новому ведру.
+func (l *limiter) sweep(now time.Time) {
+	if now.Sub(l.lastSweep) < sweepInterval && len(l.buckets) < maxLimiterKeys {
+		return
+	}
+	l.lastSweep = now
+	for k, b := range l.buckets {
+		if b.tokens+now.Sub(b.last).Seconds()*l.rate >= l.burst {
+			delete(l.buckets, k)
+		}
+	}
+}
+
+// limitBy возвращает middleware, который пропускает запрос, пока у его ключа есть токены, иначе отвечает 429.
+// Если ключ определить не удалось (key вернул false), запрос пропускается: лимит не должен ломать запросы.
+func limitBy(rl RateLimit, key func(*http.Request) (string, bool)) func(http.Handler) http.Handler {
+	l := newLimiter(rl)
+	return func(next http.Handler) http.Handler {
+		if l == nil {
+			return next
+		}
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			k, ok := key(r)
+			if !ok {
+				next.ServeHTTP(w, r)
+				return
+			}
+			if allowed, wait := l.allow(k); !allowed {
+				w.Header().Set("Retry-After", strconv.Itoa(int(math.Ceil(wait.Seconds()))))
+				writeError(w, http.StatusTooManyRequests, "rate_limited", "too many requests, slow down")
+				return
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// limitByIP ограничивает по IP клиента.
+func limitByIP(rl RateLimit, trustProxy bool) func(http.Handler) http.Handler {
+	return limitBy(rl, func(r *http.Request) (string, bool) { return clientIP(r, trustProxy), true })
+}
+
+// limitByUser ограничивает по id пользователя; ставится после Authenticate.
+func limitByUser(rl RateLimit) func(http.Handler) http.Handler {
+	return limitBy(rl, func(r *http.Request) (string, bool) {
+		id, ok := UserIDFromContext(r.Context())
+		return strconv.Itoa(id), ok
+	})
+}
+
+// clientIP определяет адрес клиента. IPv6 сворачивается до сети /64: у одного абонента их обычно сколько угодно,
+// и иначе лимит обходился бы сменой адреса.
+func clientIP(r *http.Request, trustProxy bool) string {
+	if trustProxy {
+		if xff := r.Header.Get("X-Forwarded-For"); xff != "" {
+			// последнее значение дописал наш прокси, всё левее - слова клиента
+			parts := strings.Split(xff, ",")
+			if ip := net.ParseIP(strings.TrimSpace(parts[len(parts)-1])); ip != nil {
+				return normalizeIP(ip)
+			}
+		}
+	}
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil {
+		host = r.RemoteAddr
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		return normalizeIP(ip)
+	}
+	return host
+}
+
+func normalizeIP(ip net.IP) string {
+	if v4 := ip.To4(); v4 != nil {
+		return v4.String()
+	}
+	return ip.Mask(net.CIDRMask(64, 128)).String()
+}
diff --git a/internal/handler/ratelimit_test.go b/internal/handler/ratelimit_test.go
new file mode 100644
index 0000000..6a0f547
--- /dev/null
+++ b/internal/handler/ratelimit_test.go
@@ -0,0 +1,393 @@
+package handler
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/IvanLobanok/evnavigation/internal/service/auth"
+)
+
+// fakeClock - управляемое время для детерминированных тестов ведра.
+type fakeClock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *fakeClock) now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.t
+}
+
+func (c *fakeClock) advance(d time.Duration) {
+	c.mu.Lock()
+	c.t = c.t.Add(d)
+	c.mu.Unlock()
+}
+
+func newClockLimiter(perMinute, burst int) (*limiter, *fakeClock) {
+	l := newLimiter(RateLimit{PerMinute: perMinute, Burst: burst})
+	clk := &fakeClock{t: time.Date(2026, 11, 19, 12, 0, 0, 0, time.UTC)}
+	l.now = clk.now
+	return l, clk
+}
+
+// ---------------------------------------------------------------------------
+// Ведро
+// ---------------------------------------------------------------------------
+
+func TestLimiter_BurstThenRefuse(t *testing.T) {
+	l, _ := newClockLimiter(60, 3) // 1 токен в секунду, ведро на 3
+
+	for i := 0; i < 3; i++ {
+		if ok, _ := l.allow("k"); !ok {
+			t.Fatalf("request %d within the burst must pass", i+1)
+		}
+	}
+	ok, wait := l.allow("k")
+	if ok {
+		t.Fatal("the 4th request must be refused")
+	}
+	if wait <= 0 || wait > time.Second {
+		t.Errorf("wait for the next token: got %v, want within (0, 1s]", wait)
+	}
+}
+
+func TestLimiter_RefillsOverTime(t *testing.T) {
+	l, clk := newClockLimiter(60, 2)
+	l.allow("k")
+	l.allow("k")
+	if ok, _ := l.allow("k"); ok {
+		t.Fatal("bucket must be empty")
+	}
+
+	clk.advance(1 * time.Second) // +1 токен
+	if ok, _ := l.allow("k"); !ok {
+		t.Error("one token must have been refilled after 1s")
+	}
+	if ok, _ := l.allow("k"); ok {
+		t.Error("only one token was refilled")
+	}
+
+	// ведро не переполняется выше burst: и при паузе короче интервала чистки (тут работает сам кап),
+	// и при паузе в час (тут ведро ещё и вычищается как полное)
+	for _, pause := range []time.Duration{30 * time.Second, time.Hour} {
+		clk.advance(pause)
+		for i := 0; i < 2; i++ {
+			if ok, _ := l.allow("k"); !ok {
+				t.Fatalf("pause %v: request %d must pass", pause, i+1)
+			}
+		}
+		if ok, _ := l.allow("k"); ok {
+			t.Errorf("pause %v: the bucket must be capped at burst, not accumulate tokens", pause)
+		}
+	}
+}
+
+func TestLimiter_KeysAreIndependent(t *testing.T) {
+	l, _ := newClockLimiter(60, 1)
+	if ok, _ := l.allow("a"); !ok {
+		t.Fatal("a: first request")
+	}
+	if ok, _ := l.allow("a"); ok {
+		t.Fatal("a: second request must be refused")
+	}
+	if ok, _ := l.allow("b"); !ok {
+		t.Error("b must not be affected by a")
+	}
+}
+
+func TestLimiter_SweepsIdleKeys(t *testing.T) {
+	l, clk := newClockLimiter(60, 2)
+	for i := 0; i < 50; i++ {
+		l.allow(fmt.Sprintf("k%d", i))
+	}
+	if len(l.buckets) != 50 {
+		t.Fatalf("setup: %d buckets", len(l.buckets))
+	}
+
+	clk.advance(10 * time.Minute) // все вёдра давно полны: помнить их незачем
+	l.allow("fresh")
+	if len(l.buckets) != 1 {
+		t.Errorf("idle buckets must be dropped, %d remain", len(l.buckets))
+	}
+}
+
+func TestLimiter_FailsOpenWhenTooManyKeys(t *testing.T) {
+	l, _ := newClockLimiter(60, 1)
+	for i := 0; i < maxLimiterKeys; i++ {
+		l.buckets[fmt.Sprintf("k%d", i)] = &bucket{tokens: 0, last: l.now()} // не полные: sweep их не уберёт
+	}
+	for i := 0; i < 3; i++ {
+		if ok, _ := l.allow("newcomer"); !ok {
+			t.Fatal("a new key beyond the memory cap must be let through, not refused")
+		}
+	}
+	if len(l.buckets) > maxLimiterKeys {
+		t.Errorf("memory cap exceeded: %d keys", len(l.buckets))
+	}
+}
+
+func TestLimiter_DisabledByZeroRate(t *testing.T) {
+	for _, rl := range []RateLimit{{}, {PerMinute: 0, Burst: 5}, {PerMinute: -3, Burst: 5}} {
+		if newLimiter(rl) != nil {
+			t.Errorf("%+v must disable the limiter", rl)
+		}
+	}
+	// а выключенный middleware ничего не меняет
+	h := limitByIP(RateLimit{}, false)(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusNoContent) }))
+	for i := 0; i < 50; i++ {
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+		if rec.Code != http.StatusNoContent {
+			t.Fatalf("request %d: %d", i, rec.Code)
+		}
+	}
+}
+
+func TestLimiter_ZeroBurstStillAllowsOneRequest(t *testing.T) {
+	l, _ := newClockLimiter(60, 0)
+	if ok, _ := l.allow("k"); !ok {
+		t.Error("a bucket must hold at least one token")
+	}
+}
+
+func TestLimiter_ConcurrentUse(t *testing.T) {
+	l := newLimiter(RateLimit{PerMinute: 60, Burst: 100})
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	passed := 0
+	for i := 0; i < 400; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if ok, _ := l.allow("shared"); ok {
+				mu.Lock()
+				passed++
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	// ведро на 100 токенов и 1 токен/с: за мгновение пройти может немного больше 100, но не 400
+	if passed < 100 || passed > 102 {
+		t.Errorf("passed %d of 400, want about 100", passed)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// IP клиента
+// ---------------------------------------------------------------------------
+
+func TestClientIP(t *testing.T) {
+	tests := []struct {
+		name       string
+		remote     string
+		xff        string
+		trustProxy bool
+		want       string
+	}{
+		{"plain ipv4", "203.0.113.7:51000", "", false, "203.0.113.7"},
+		{"xff is ignored without trust (it is client-controlled)", "203.0.113.7:51000", "1.2.3.4", false, "203.0.113.7"},
+		{"trusted proxy: last xff entry", "10.0.0.2:4444", "9.9.9.9, 198.51.100.5", true, "198.51.100.5"},
+		{"trusted proxy: forged left entries are ignored", "10.0.0.2:4444", "6.6.6.6, 7.7.7.7, 198.51.100.5", true, "198.51.100.5"},
+		{"trusted proxy: garbage xff falls back to the peer", "10.0.0.2:4444", "not-an-ip", true, "10.0.0.2"},
+		{"trusted proxy: no xff falls back to the peer", "10.0.0.2:4444", "", true, "10.0.0.2"},
+		{"ipv6 is folded to /64", "[2001:db8:1:2:aaaa:bbbb:cccc:dddd]:80", "", false, "2001:db8:1:2::"},
+		{"another address of the same /64 is the same client", "[2001:db8:1:2:1111:2222:3333:4444]:80", "", false, "2001:db8:1:2::"},
+		{"ipv4-mapped ipv6 is treated as ipv4", "[::ffff:203.0.113.7]:80", "", false, "203.0.113.7"},
+		{"remote without a port", "203.0.113.7", "", false, "203.0.113.7"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodGet, "/", nil)
+			req.RemoteAddr = tc.remote
