# Скопируйте в .env:  cp .env.example .env
# `make run` подхватывает .env сам; значения ниже совпадают со значениями по умолчанию,
# кроме DB_PORT: docker-compose пробрасывает PostgreSQL на хост-порт 5433.
# Файл читается командой `source`, поэтому значения без пробелов и без кавычек.

# --- сервис ---------------------------------------------------------------
# при APP_ENV=production JWT_SECRET обязан быть не короче 32 символов
APP_ENV=development
SERVER_PORT=8080

# --- PostgreSQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=evnav_dev_pass
DB_NAME=evnavigation
DB_SSLMODE=disable

# --- авторизация ----------------------------------------------------------
JWT_SECRET=dev_secret_change_me
# срок жизни access-токена: 30m, 24h, 72h ...
JWT_TTL=24h

# --- провайдер маршрутов --------------------------------------------------
# mock - прямая линия, нарезанная на сегменты по 5 км (для разработки)
# yandex - пока не реализован: приложение не запустится с этим значением
ROUTE_PROVIDER=mock
YANDEX_API_KEY=

# --- кэш ответов провайдера (необязателен) --------------------------------
# пусто - кэш выключен; пример: redis://localhost:6380/0 (порт из docker-compose)
REDIS_URL=
ROUTE_CACHE_TTL=30m

# --- расчёт маршрута ------------------------------------------------------
# ниже этого процента заряд считается критическим: нужна остановка на зарядку
CRITICAL_CHARGE_PERCENT=15
# минимальный остаток заряда по приезде на станцию
MIN_ARRIVAL_PERCENT=5
# до скольки процентов заряжаемся на станции
TARGET_CHARGE_PERCENT=80
# радиус поиска станций вокруг точки, метры
STATION_SEARCH_RADIUS_METERS=5000
# максимум остановок на одном маршруте
MAX_CHARGING_STOPS=5
# сколько станций проверять за один поиск (каждая проверка - запрос маршрута к провайдеру)
MAX_STATION_CANDIDATES=3
# шаг и глубина отката назад по маршруту, если у критической точки станции нет, км
LOOKBACK_STEP_KM=5
MAX_LOOKBACK_KM=30
