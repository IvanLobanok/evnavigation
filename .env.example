# Скопируйте в .env:  cp .env.example .env
# `make run` подхватывает .env сам; значения ниже совпадают со значениями по умолчанию,
# кроме DB_PORT: docker-compose пробрасывает PostgreSQL на хост-порт 5433.
# Файл читается командой `source`, поэтому значения без пробелов и без кавычек.

# --- сервис ---------------------------------------------------------------
# при APP_ENV=production JWT_SECRET обязан быть не короче 32 символов
APP_ENV=development
SERVER_PORT=8080

# --- PostgreSQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=evnav_dev_pass
DB_NAME=evnavigation
DB_SSLMODE=disable

# --- авторизация ----------------------------------------------------------
JWT_SECRET=dev_secret_change_me
# срок жизни access-токена: 30m, 24h, 72h ...
JWT_TTL=24h

# --- провайдер маршрутов --------------------------------------------------
# mock - прямая линия, нарезанная на сегменты по 5 км (для разработки)
# yandex - пока не реализован: приложение не запустится с этим значением
ROUTE_PROVIDER=mock
YANDEX_API_KEY=

# --- кэш ответов провайдера (необязателен) --------------------------------
# пусто - кэш выключен; пример: redis://localhost:6380/0 (порт из docker-compose)
REDIS_URL=
ROUTE_CACHE_TTL=30m

# --- расчёт маршрута ------------------------------------------------------
# ниже этого процента заряд считается критическим: нужна остановка на зарядку
CRITICAL_CHARGE_PERCENT=15
# минимальный остаток заряда по приезде на станцию
MIN_ARRIVAL_PERCENT=5
# до скольки процентов заряжаемся на станции
TARGET_CHARGE_PERCENT=80
# радиус поиска станций вокруг точки, метры
STATION_SEARCH_RADIUS_METERS=5000
# максимум остановок на одном маршруте
MAX_CHARGING_STOPS=5
# сколько станций проверять за один поиск (каждая проверка - запрос маршрута к провайдеру)
MAX_STATION_CANDIDATES=3
# шаг и глубина отката назад по маршруту, если у критической точки станции нет, км
LOOKBACK_STEP_KM=5
MAX_LOOKBACK_KM=30
# сколько станций-кандидатов проверять одновременно. 1 - по одной (меньше вызовов провайдера),
# больше - быстрее ответ, но кандидаты шага проверяются сразу все, и вызовов провайдера становится больше
ROUTE_CANDIDATE_PARALLELISM=1

# --- защита от перегрузки -------------------------------------------------
# размер пула соединений с PostgreSQL; 0 - по умолчанию pgx: max(4, число CPU).
# Суммарно по всем репликам приложения не должен превышать max_connections у PostgreSQL
DB_MAX_CONNS=0
# одновременных вызовов провайдера маршрутов (общий потолок на внешний API); 0 - без ограничения
ROUTE_PROVIDER_MAX_CONCURRENCY=32
# одновременных bcrypt-операций (регистрация, логин); 0 - по числу CPU
BCRYPT_MAX_CONCURRENCY=0
# ограничения частоты запросов: запросов в минуту и размер «пачки», которую можно отправить сразу.
# 0 запросов в минуту - ограничение выключено. Сверх лимита сервер отвечает 429 с Retry-After.
# по IP: POST /auth/register и /auth/login
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_AUTH_BURST=10
# по IP: GET /ev-models и /stations/nearby
RATE_LIMIT_PUBLIC_PER_MIN=300
RATE_LIMIT_PUBLIC_BURST=60
# по пользователю: POST /routes
RATE_LIMIT_ROUTES_PER_MIN=60
RATE_LIMIT_ROUTES_BURST=10
# IP клиента брать из X-Forwarded-For. true - только если перед сервисом стоит свой прокси, который заголовок дописывает;
# иначе клиент подделает IP и обойдёт лимит. За прокси при false все клиенты делят один IP прокси и один общий лимит
TRUST_PROXY_HEADERS=false
